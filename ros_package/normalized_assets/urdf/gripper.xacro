<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!--
    Assignment-local parallel-jaw gripper.

    UR tool0 uses +Z as the outward tool axis. The gripper therefore extends
    along +Z, and both positive prismatic joint coordinates open the fingers
    symmetrically along +/-X. The joint-limit opening ranges from 0 to 80 mm;
    normal commands use 4 to 75 mm to stay clear of both limits.
  -->
  <xacro:macro name="assignment_parallel_gripper" params="parent sim_ignition">
    <link name="gripper_base">
      <inertial>
        <mass value="0.20"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000108333" ixy="0" ixz="0"
                 iyy="0.000228333" iyz="0" izz="0.000283333"/>
      </inertial>
      <!-- Cosmetic housing only. The collision body and TCP remain calibrated. -->
      <visual>
        <geometry><box size="0.120 0.074 0.038"/></geometry>
        <material name="gripper_teal"><color rgba="0.08 0.28 0.32 1"/></material>
      </visual>
      <collision>
        <geometry><box size="0.110 0.070 0.040"/></geometry>
      </collision>
    </link>

    <!-- Centering the palm 20 mm from tool0 keeps its rear face on tool0. -->
    <joint name="tool0-gripper_base" type="fixed">
      <parent link="${parent}"/>
      <child link="gripper_base"/>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
    </joint>

    <link name="left_finger_link">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0.040" rpy="0 0 0"/>
        <inertia ixx="0.000029271" ixy="0" ixz="0"
                 iyy="0.000027267" iyz="0" izz="0.000003204"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0.019" rpy="0 0 0"/>
        <geometry><box size="0.012 0.025 0.038"/></geometry>
        <material name="left_finger_amber"><color rgba="0.95 0.43 0.12 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.019" rpy="0 0 0"/>
        <geometry><box size="0.012 0.025 0.038"/></geometry>
      </collision>
    </link>

    <joint name="left_finger_joint" type="prismatic">
      <parent link="gripper_base"/>
      <child link="left_finger_link"/>
      <!-- One millimetre separates the moving collision from the palm. -->
      <origin xyz="0.006 0 0.021" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="0.040" effort="40.0" velocity="0.08"/>
      <dynamics damping="0.2" friction="0.0"/>
    </joint>

    <link name="right_finger_link">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0.040" rpy="0 0 0"/>
        <inertia ixx="0.000029271" ixy="0" ixz="0"
                 iyy="0.000027267" iyz="0" izz="0.000003204"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0.019" rpy="0 0 0"/>
        <geometry><box size="0.012 0.025 0.038"/></geometry>
        <material name="right_finger_amber"><color rgba="0.95 0.43 0.12 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.019" rpy="0 0 0"/>
        <geometry><box size="0.012 0.025 0.038"/></geometry>
      </collision>
    </link>

    <joint name="right_finger_joint" type="prismatic">
      <parent link="gripper_base"/>
      <child link="right_finger_link"/>
      <!-- One millimetre separates the moving collision from the palm. -->
      <origin xyz="-0.006 0 0.021" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="0.0" upper="0.040" effort="40.0" velocity="0.08"/>
      <dynamics damping="0.2" friction="0.0"/>
    </joint>

    <!-- Intended grasp center is 60 mm along tool0 +Z, between the fingers. -->
    <link name="gripper_tcp"/>
    <joint name="gripper_base-gripper_tcp" type="fixed">
      <parent link="gripper_base"/>
      <child link="gripper_tcp"/>
      <origin xyz="0 0 0.040" rpy="0 0 0"/>
    </joint>

    <xacro:if value="${sim_ignition}">
      <ros2_control name="assignment_gripper" type="system">
        <hardware>
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
        </hardware>
        <joint name="left_finger_joint">
          <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">0.040</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0375</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
        <joint name="right_finger_joint">
          <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">0.040</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0375</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </ros2_control>
    </xacro:if>
  </xacro:macro>
</robot>
